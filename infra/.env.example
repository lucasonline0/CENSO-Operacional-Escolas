# ─── API ───────────────────────────────────────────────────────────────────────
PORT=8000
APP_ENV=development

# ─── Banco de dados ────────────────────────────────────────────────────────────
# Setup padrão local: copie DATABASE_PUBLIC_URL do serviço Postgres no Railway
# e use o valor abaixo como DB_DSN.
# Nunca versione a URL real do banco.
DB_DSN="postgresql://usuario:senha@host-publico:porta/railway"

# A API resolve a conexão nesta ordem:
#   1. DATABASE_URL
#   2. DB_DSN
#   3. DB_HOST + DB_PORT + DB_USER + DB_PASSWORD + DB_NAME
#
# Dentro do Railway, prefira apontar DB_DSN ou DATABASE_URL para a URL PRIVADA
# do serviço Postgres, por exemplo: ${{Postgres.DATABASE_URL}}
# DATABASE_URL="postgresql://..."

# Fallback opcional para PostgreSQL local:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=censo_user
# DB_PASSWORD=sua_senha_forte_aqui
# DB_NAME=censo_db
# DB_SSLMODE=disable

# ─── Admin Dashboard ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin_local

# Gere com:
#   cd api
#   go run ./cmd/genpasswd 'SuaSenhaCom12CaracteresOuMais'
ADMIN_PASSWORD_HASH=$2a$10$SUBSTITUIR_PELO_HASH_GERADO

# Segredo JWT — mínimo de 32 caracteres.
# Gere com:
#   openssl rand -hex 32
ADMIN_JWT_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Para desenvolvimento local do frontend:
ALLOWED_ORIGINS=http://localhost:3000

# ─── Período de preenchimento ─────────────────────────────────────────────────
# O formulário público fica FECHADO quando esta variável é false ou está ausente.
# Use true somente quando o período de preenchimento estiver oficialmente aberto.
CENSUS_SUBMISSIONS_ENABLED=false

# ─── Segurança opcional dos endpoints públicos ────────────────────────────────
# Se definido, o backend exige X-API-Key nos endpoints públicos protegidos.
# PUBLIC_API_KEY=
# TRUSTED_PROXY_COUNT=1

# ─── Frontend ──────────────────────────────────────────────────────────────────
# Opcional quando a API local estiver em http://localhost:8000, pois esse já é o
# fallback do frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_KEY=

# ─── Integrações Google (LEGADO / NÃO NECESSÁRIAS NO SETUP PADRÃO) ────────────
# O projeto ainda contém código legado de Sheets/Drive, mas essas variáveis não
# são necessárias para iniciar a API nem para trabalhar no fluxo principal do
# painel /admin baseado em PostgreSQL.
#
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# SPREADSHEET_ID=
# DRIVE_ROOT_FOLDER_ID=
# GOOGLE_IMPERSONATE_EMAIL=
